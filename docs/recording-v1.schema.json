{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/becool3000/PigmentStudio/docs/recording-v1.schema.json",
  "title": "Pigment Studio Recording (v1 and v2)",
  "description": "Deterministic stroke and command recording format for Pigment Studio headless rendering, batch animation, and AI agent control.",
  "type": "object",
  "required": ["format", "events"],
  "properties": {
    "format": {
      "type": "string",
      "enum": ["pigment-studio-recording-v1", "pigment-studio-recording-v2"]
    },
    "underlayer_path": {
      "type": "string",
      "description": "Optional PNG path loaded onto dry_substrate before events run (relative to the recording JSON or absolute)."
    },
    "lighting": {
      "$ref": "#/$defs/LightingConfig"
    },
    "tile": {
      "type": "boolean",
      "default": false,
      "description": "Initial seamless tiling state."
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecordedEvent"
      }
    }
  },
  "$defs": {
    "LightingConfig": {
      "type": "object",
      "required": ["enabled", "impasto_depth", "canvas_weave", "specular_sheen", "light_angle_deg", "light_elevation_deg"],
      "properties": {
        "enabled": { "type": "boolean" },
        "impasto_depth": { "type": "number", "minimum": 0, "maximum": 2 },
        "canvas_weave": { "type": "number", "minimum": 0, "maximum": 1 },
        "specular_sheen": { "type": "number", "minimum": 0, "maximum": 2 },
        "light_angle_deg": { "type": "number", "minimum": 0, "maximum": 360 },
        "light_elevation_deg": { "type": "number", "minimum": 5, "maximum": 89 }
      }
    },
    "BrushKind": {
      "type": "string",
      "enum": ["round", "flat", "filbert", "fan", "palette_knife", "soft_mop"]
    },
    "SurfaceKind": {
      "type": "string",
      "enum": ["canvas", "palette"]
    },
    "ServiceAction": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "tube"],
          "properties": {
            "kind": { "const": "load" },
            "tube": { "type": "integer", "minimum": 0, "maximum": 7 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "tube"],
          "properties": {
            "kind": { "const": "dip" },
            "tube": { "type": "integer", "minimum": 0, "maximum": 7 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "slot"],
          "properties": {
            "kind": { "const": "dip_rack" },
            "slot": { "type": "integer", "minimum": 0, "maximum": 19 },
            "lane": { "enum": ["left", "middle", "right"], "description": "Dip just this flat-brush lane. Omit to dip the whole brush." }
          }
        },
        {
          "type": "object",
          "required": ["kind", "slot"],
          "properties": {
            "kind": { "const": "dip_custom" },
            "slot": { "type": "integer", "minimum": 0, "maximum": 63 },
            "lane": { "enum": ["left", "middle", "right"], "description": "Dip just this flat-brush lane. Omit to dip the whole brush." }
          }
        },
        {
          "type": "object",
          "required": ["kind", "fraction"],
          "properties": {
            "kind": { "const": "wipe" },
            "fraction": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "RecordedSample": {
      "type": "object",
      "required": ["x", "y", "pressure"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "pressure": { "type": "number", "minimum": 0, "maximum": 1 },
        "timestamp_ms": { "type": "integer", "minimum": 0, "default": 0 },
        "angle_deg": { "type": "number", "description": "Optional directional brush angle at this sample, interpolated along the shortest rotation." }
      }
    },
    "RecordedEvent": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "brush", "action"],
          "properties": {
            "type": { "const": "service" },
            "brush": { "$ref": "#/$defs/BrushKind" },
            "action": { "$ref": "#/$defs/ServiceAction" },
            "legacy_reservoir": { "type": "boolean", "default": false, "description": "Use the legacy Round or Flat reservoir for this action when preserving v1 replay." }
          }
        },
        {
          "type": "object",
          "required": ["type", "slot", "recipe"],
          "properties": {
            "type": { "const": "equip_rack" },
            "slot": { "type": "integer", "minimum": 0, "maximum": 19 },
            "recipe": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": { "type": "number", "minimum": 0 }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "surface", "brush", "samples"],
          "properties": {
            "type": { "const": "stroke" },
            "surface": { "$ref": "#/$defs/SurfaceKind" },
            "brush": { "$ref": "#/$defs/BrushKind" },
            "ink": { "type": "boolean", "default": false },
            "charcoal": { "type": "boolean", "default": false },
            "erase": { "type": "boolean", "default": false },
            "diameter": { "type": "number", "minimum": 1, "maximum": 256, "default": 64 },
            "angle_deg": { "type": "number", "default": 0 },
            "auto_follow": { "type": "boolean", "default": false, "description": "Turn directional brushes along the stroke wherever a sample does not set its own angle." },
            "knife_sweep": { "type": "boolean", "default": false, "description": "Integrate palette knife contact between samples. The desktop records this for new palette knife strokes." },
            "bristle_sweep": { "type": "boolean", "default": false, "description": "Integrate hog-bristle flat contact between samples. The desktop records this for new flat strokes." },
            "round_pressure": { "type": "boolean", "default": false, "description": "Use the refined Round brush pressure curve. The desktop records this for new Round strokes." },
            "legacy_reservoir": { "type": "boolean", "default": false, "description": "Use the legacy Round or Flat reservoir for this stroke when preserving v1 replay." },
            "tile": { "type": "boolean", "default": false },
            "samples": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/RecordedSample" }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "surface"],
          "properties": {
            "type": { "const": "clear" },
            "surface": { "$ref": "#/$defs/SurfaceKind" }
          }
        },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "clear_sketch" } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "clear_reference" } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "dry_canvas" } } },
        {
          "type": "object",
          "required": ["type", "slot", "surface", "x", "y"],
          "properties": {
            "type": { "const": "save_swatch" },
            "slot": { "type": "integer", "minimum": 0, "maximum": 63 },
            "surface": { "$ref": "#/$defs/SurfaceKind" },
            "x": { "type": "integer", "minimum": 0, "maximum": 1023 },
            "y": { "type": "integer", "minimum": 0, "maximum": 1023 }
          }
        },
        {
          "type": "object",
          "required": ["type", "slot"],
          "properties": {
            "type": { "const": "remove_swatch" },
            "slot": { "type": "integer", "minimum": 0, "maximum": 63 }
          }
        },
        {
          "type": "object",
          "required": ["type", "enabled"],
          "properties": {
            "type": { "const": "set_tile" },
            "enabled": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "import_underlayer" },
            "path": { "type": "string" }
          }
        }
      ]
    }
  }
}
